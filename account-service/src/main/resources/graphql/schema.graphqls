type Query {
    accounts: [Account]
    accountById(id: ID!): Account
}

type Mutation {
    createAccount(account: AccountInput!): Account
    changeStatus(id: ID!, status: AccountStatus!): Account
    debit(id: ID!, amount: Float!): Account
    credit(id: ID!, amount: Float!): Account
}

type Account {
    id: ID
    customerReference: String
    status: AccountStatus
    currency: String
    balance: Float
}

enum AccountStatus {
    ACTIVE
    BLOCKED
}

input AccountInput {
    customerReference: String!
    currency: String!
    balance: Float!
}